# AI Notification Agent - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# WHATSAPP CONFIGURATION (Twilio)
# ============================================
# Get free trial account at: https://www.twilio.com
# After signup, get these from Twilio Console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================
# For Gmail, you need an App Password
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate app password for "Mail"
# 5. Use that 16-character password below

# Personal Gmail
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Student Email (UON) - may need different setup
STUDENT_EMAIL_PASSWORD=your_student_email_password_here

# ============================================
# SCHEDULE CONFIGURATION
# ============================================
# Times to send daily digests (24-hour format)
MORNING_DIGEST=06:00
EVENING_DIGEST=18:00